{
  "name": "tasuku",
  "version": "0.0.0-semantic-release",
  "description": "タスク — The minimal task runner",
  "keywords": [
    "simple",
    "minimal",
    "task",
    "runner",
    "cli"
  ],
  "license": "MIT",
  "repository": "privatenumber/tasuku",
  "funding": "https://github.com/privatenumber/tasuku?sponsor=1",
  "author": {
    "name": "Hiroki Osame",
    "email": "hiroki.osame@gmail.com"
  },
  "files": [
    "dist",
    "skills"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./inline": {
      "types": "./dist/inline.d.mts",
      "default": "./dist/inline.mjs"
    },
    "./create": {
      "types": "./dist/create.d.mts",
      "default": "./dist/create.mjs"
    }
  },
  "imports": {
    "#tasuku": {
      "default": "./dist/index.mjs"
    },
    "#tasuku/inline": {
      "default": "./dist/inline.mjs"
    },
    "#tasuku/create": {
      "default": "./dist/create.mjs"
    }
  },
  "engines": {
    "node": ">=20.20"
  }
}