{
	"name": "tasuku",
	"version": "0.0.0-semantic-release",
	"description": "タスク — The minimal task runner",
	"keywords": [
		"simple",
		"minimal",
		"task",
		"runner",
		"cli"
	],
	"license": "MIT",
	"repository": "privatenumber/tasuku",
	"funding": "https://github.com/privatenumber/tasuku?sponsor=1",
	"author": {
		"name": "Hiroki Osame",
		"email": "hiroki.osame@gmail.com"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		},
		"./claude": {
			"types": "./dist/claude.d.mts",
			"default": "./dist/claude.mjs"
		},
		"./blink": {
			"types": "./dist/blink.d.mts",
			"default": "./dist/blink.mjs"
		},
		"./codex": {
			"types": "./dist/codex.d.mts",
			"default": "./dist/codex.mjs"
		}
	},
	"imports": {
		"#tasuku": {
			"types": "./src/index.ts",
			"development": "./src/index.ts",
			"default": "./dist/index.mjs"
		},
		"#tasuku/claude": {
			"types": "./src/claude.ts",
			"development": "./src/claude.ts",
			"default": "./dist/claude.mjs"
		},
		"#tasuku/blink": {
			"types": "./src/blink.ts",
			"development": "./src/blink.ts",
			"default": "./dist/blink.mjs"
		},
		"#tasuku/codex": {
			"types": "./src/codex.ts",
			"development": "./src/codex.ts",
			"default": "./dist/codex.mjs"
		}
	},
	"packageManager": "pnpm@10.19.0",
	"scripts": {
		"lint": "lintroll --node --cache --git",
		"test": "node -C development tests/index.ts",
		"type-check": "tsc",
		"build": "pkgroll --target=node20 --minify --clean-dist",
		"prepack": "clean-pkg-json",
		"generate-media": "node scripts/generate-media.ts"
	},
	"engines": {
		"node": ">=20.20"
	},
	"devDependencies": {
		"@types/node": "^24.10.9",
		"ansi-escapes": "^7.2.0",
		"ansi-regex": "^6.2.2",
		"ansis": "^4.2.0",
		"clean-pkg-json": "^1.3.0",
		"concurrently": "^9.2.1",
		"expect-type": "^1.3.0",
		"fs-fixture": "^2.11.0",
		"lintroll": "^1.26.1",
		"manten": "^1.10.0",
		"nano-spawn": "^2.0.0",
		"node-pty": "1.2.0-beta.10",
		"p-map": "^5.5.0",
		"pkgroll": "^2.21.5",
		"string-width": "^5.1.2",
		"strip-ansi": "^7.1.2",
		"typescript": "^5.9.3"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"node-pty"
		]
	}
}
