{
	"name": "tasuku",
	"version": "0.0.0-semantic-release",
	"description": "タスク — The minimal task runner",
	"keywords": [
		"simple",
		"minimal",
		"task",
		"runner",
		"cli"
	],
	"license": "MIT",
	"repository": "privatenumber/tasuku",
	"funding": "https://github.com/privatenumber/tasuku?sponsor=1",
	"author": {
		"name": "Hiroki Osame",
		"email": "hiroki.osame@gmail.com"
	},
	"files": [
		"dist",
		"skills"
	],
	"type": "module",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		},
		"./inline": {
			"types": "./dist/inline.d.mts",
			"default": "./dist/inline.mjs"
		},
		"./create": {
			"types": "./dist/create.d.mts",
			"default": "./dist/create.mjs"
		}
	},
	"imports": {
		"#tasuku": {
			"types": "./src/index.ts",
			"development": "./src/index.ts",
			"default": "./dist/index.mjs"
		},
		"#tasuku/inline": {
			"types": "./src/inline.ts",
			"development": "./src/inline.ts",
			"default": "./dist/inline.mjs"
		},
		"#tasuku/create": {
			"types": "./src/create.ts",
			"development": "./src/create.ts",
			"default": "./dist/create.mjs"
		}
	},
	"packageManager": "pnpm@12.3.4",
	"scripts": {
		"lint": "lintroll --node --git",
		"test": "node -C development tests/index.ts",
		"type-check": "tsc",
		"build": "pkgroll --target=node20 --minify --clean-dist",
		"prepack": "clean-pkg-json",
		"generate-media": "node scripts/generate-media.ts"
	},
	"engines": {
		"node": ">=20.20"
	},
	"devDependencies": {
		"@types/node": "^26.0.0",
		"@xterm/headless": "^6.0.0",
		"ansi-escapes": "^7.3.0",
		"ansis": "^4.3.1",
		"clean-pkg-json": "^2.0.0",
		"concurrently": "^10.0.3",
		"expect-type": "^1.3.0",
		"fs-fixture": "^2.14.0",
		"lintroll": "^1.30.2",
		"manten": "2.0.0",
		"nano-spawn": "^2.1.0",
		"p-map": "^7.0.7",
		"pkgroll": "^2.27.1",
		"pty-spawn": "^1.1.0",
		"string-width": "^8.2.2",
		"strip-ansi": "^7.2.0",
		"typescript": "^5.9.3"
	}
}
